# ---- Required in production (set these in Vercel -> Project -> Settings -> Environment Variables) ----

# Upstash Redis (structured content, admin users, sessions, rate limits).
# Get them: https://console.upstash.com -> create a Redis database -> "REST API" tab.
# Or on Vercel: Storage / Marketplace -> Upstash Redis -> connect to the project (variables are added for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (uploaded posters, authorised photographs, hero portrait).
# Get it: Vercel project -> Storage -> Create Blob store (Public access) -> connect to project.
BLOB_READ_WRITE_TOKEN=

# Secret used to sign admin session cookies. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ---- Optional ----

# Public site URL used for canonical links, sitemap and Open Graph. Leave empty until a domain is bought;
# the app falls back to the Vercel deployment URL, then http://localhost:3000.
# (This one is intentionally public - never put secrets in NEXT_PUBLIC_ variables.)
NEXT_PUBLIC_SITE_URL=

# Local development without Upstash/Blob: leave the three variables above empty and the app uses a local
# file store in .data/ (disabled in production). ADMIN_SESSION_SECRET is still required for admin login.
